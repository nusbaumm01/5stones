{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z2-9]{6}$/) && newData.hasChildren(['host', 'hostColor', 'moveCount', 'round', 'tournament', 'createdAt'])",
        "host": {
          ".validate": "data.exists() ? newData.val() === data.val() : newData.val() === auth.uid"
        },
        "guest": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && auth.uid !== data.parent().child('host').val()",
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "hostColor": {
          ".validate": "newData.val() === 'one' || newData.val() === 'two'"
        },
        "tournament": { ".validate": "newData.isBoolean()" },
        "round": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "moveCount": {
          ".write": "auth != null && auth.uid === data.parent().child('guest').val()",
          ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val() + 1 && newData.parent().child('moves').child('' + data.val()).exists()) || (newData.val() === 0 && auth.uid === newData.parent().child('host').val()))"
        },
        "moves": {
          "$i": {
            ".write": "auth != null && auth.uid === data.parent().parent().child('guest').val()",
            ".validate": "!data.exists() && newData.hasChildren(['r', 'c']) && newData.parent().parent().child('guest').exists() && $i === '' + data.parent().parent().child('moveCount').val() && auth.uid === (((data.parent().parent().child('moveCount').val() % 2 === 0) === (data.parent().parent().child('hostColor').val() === 'one')) ? data.parent().parent().child('host').val() : data.parent().parent().child('guest').val())",
            "r": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 19" },
            "c": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 19" },
            "$other": { ".validate": false }
          }
        },
        "rematch": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && auth.uid === data.parent().parent().child('guest').val()",
            ".validate": "newData.isNumber()"
          }
        },
        "left": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && auth.uid === data.parent().parent().child('guest').val()",
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
